# Maintainer: flumpsi <flumpsi@outlook.com>

# NOTE! This package is compiled without a -j flag, since some users might prefer to set it on their own.
# If you would like to set the -j flag, please edit the PKGBUILD or use MAKEFLAGS e.g: MAKEFLAGS="-j$(nproc)"
pkgname=hackmatrix-git
pkgrel=1
pkgdesc="HackMatrix is a 3D Linux desktop environment (which can also be a game engine)"
pkgver=r1154.1.stable.r327.gddbd86b
arch=('x86_64')
url="https://github.com/collinalexbell/HackMatrix"
license=('MIT')
provides=("hackmatrix")
conflicts=(
  "hackmatrix"
  "hackmatrix-bin"
)
depends=(
  'wayland'
  'mesa'
  'libglvnd'
  'sqlite'
  'zeromq'
  'assimp'
  'fmt'
  'spdlog'
  'protobuf'
  'wlroots0.19'
  'libxcb'
  'pixman'
  'libxkbcommon'
  'libdrm'
)

makedepends=(
  'base-devel'
  'cmake'
  'git'
  'wayland-protocols'
  'protobuf'
  'meson'
  'ninja'
)
optdepends=(
  'wofi: default application menu'
  'xorg-xwayland: run X11 applications'
)

# Set HACKMATRIX_LOCAL_SOURCE=/path/to/HackMatrix to package the current
# working tree instead of cloning the upstream repository. Copy this PKGBUILD,
# HackMatrix.desktop and matrix-script to an empty directory first:
#
#   mkdir -p /tmp/hm-pkg
#   cp PKGBUILD HackMatrix.desktop matrix-script /tmp/hm-pkg/
#   cd /tmp/hm-pkg
#   HACKMATRIX_LOCAL_SOURCE=/path/to/HackMatrix makepkg -f
#
# The git source is used by default (AUR/git package behaviour).
_local_source="${HACKMATRIX_LOCAL_SOURCE:-}"

if [[ -n "$_local_source" ]]; then
  source=(
    "HackMatrix.desktop"
    "matrix-script"
  )
  sha256sums=(
    'db55d2c5e3d828f867d3c5a43e5b95519a0dfcb4ca669c40d467f4395e3ec6e4'
    '6281237d97263d6e575d9ca9833687b4463cece257838676e1fc7b1db3a555a8'
  )
else
  source=(
    "HackMatrix::git+https://github.com/collinalexbell/HackMatrix.git"
    "HackMatrix.desktop"
    "matrix-script"
  )
  sha256sums=(
    'SKIP'
    'db55d2c5e3d828f867d3c5a43e5b95519a0dfcb4ca669c40d467f4395e3ec6e4'
    '6281237d97263d6e575d9ca9833687b4463cece257838676e1fc7b1db3a555a8'
  )
fi

pkgver() {
  if [[ -n "$_local_source" ]]; then
    cd "$_local_source"
  else
    cd "$srcdir/HackMatrix"
  fi
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git describe --long --tags --always | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//')"
}

prepare() {
  if [[ -n "$_local_source" ]]; then
    return 0
  fi
  cd "$srcdir/HackMatrix"
  # The system wlroots is preferred; only fetch the submodules that are
  # actually needed for this configuration.
  if pkg-config --exists wlroots-0.19; then
    git submodule update --init tracy
  else
    git submodule update --init --recursive
  fi
}

build() {
  local src="${_local_source:-$srcdir/HackMatrix}"
  cmake -S "$src" -B "$srcdir/build" -DCMAKE_BUILD_TYPE=Release
  cmake --build "$srcdir/build"
}

package() {
  local src="${_local_source:-$srcdir/HackMatrix}"
  install -Dm755 "$srcdir/matrix-script" "$pkgdir/usr/bin/hackmatrix"
  install -Dm755 "$srcdir/build/matrix" "$pkgdir/usr/share/HackMatrix/hackmatrix-binary"
  install -Dm755 "$srcdir/HackMatrix.desktop" "$pkgdir/usr/share/applications/HackMatrix.desktop"
  install -Dm644 "$src/config.yaml" "$pkgdir/usr/share/HackMatrix/config.yaml"
  install -d "$pkgdir/usr/share/HackMatrix"
  cp -rv "$src/vox" "$src/shaders" "$src/scripts" "$src/db" "$pkgdir/usr/share/HackMatrix/"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
